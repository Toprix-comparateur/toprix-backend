# Copier ce fichier en .env et renseigner les valeurs

SECRET_KEY=changez-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — origines autorisées (séparées par virgule)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://toprix.net

# MongoDB — mêmes URIs que le projet toprix original
MONGODB_TUNISIANET_URI=mongodb+srv://...
MONGODB_TUNISIANET_DB=Produits
MONGODB_TUNISIANET_COLLECTION=DB

MONGODB_MYTEK_URI=mongodb+srv://...
MONGODB_MYTEK_DB=Produits
MONGODB_MYTEK_COLLECTION=DB

MONGODB_SPACENET_URI=mongodb+srv://...
MONGODB_SPACENET_DB=Produits
MONGODB_SPACENET_COLLECTION=DB

MONGODB_COMPARATIF_URI=mongodb+srv://...
MONGODB_COMPARATIF_DB=Produits
MONGODB_COMPARATIF_COLLECTION=DB

# URL publique du backend (pour les images media)
API_BASE_URL=http://localhost:8000

# E-mail : boîte contact@toprix.tn sur serv00 (formulaires Contact et Devis)
EMAIL_HOST_USER=contact@toprix.tn
EMAIL_HOST_PASSWORD=
CONTACT_EMAIL=contact@toprix.tn
# Secret partagé avec le site (secret Cloudflare CONTACT_API_KEY). Généré avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONTACT_API_KEY=
